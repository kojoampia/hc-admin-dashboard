{
  "name": "hc-admin-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "Health Connect Admin Dashboard",
  "license": "Apache-2.0",
  "scripts": {
    "build": "npm run webapp:prod --",
    "check:csp": "node scripts/check-index-csp.mjs",
    "ci:frontend:build": "npm run webapp:build:prod",
    "ci:frontend:test": "npm run ci:frontend:build && npm test",
    "clean-www": "rimraf target/classes/static/",
    "cleanup": "rimraf target/",
    "jest": "jest --coverage --logHeapUsage --maxWorkers=2 --config jest.conf.js",
    "lint": "eslint . --ext .js,.ts",
    "lint:fix": "npm run lint -- --fix",
    "mock:api": "json-server --watch db.json --routes routes.json --port 5508",
    "prepare": "husky install",
    "prettier:check": "prettier --check \"{,src/**/,webpack/,.blueprint/**/}*.{md,json,yml,html,cjs,mjs,js,ts,tsx,css,scss,java}\"",
    "prettier:format": "prettier --write \"{,src/**/,webpack/,.blueprint/**/}*.{md,json,yml,html,cjs,mjs,js,ts,tsx,css,scss,java}\"",
    "serve": "npm run start --",
    "start": "ng serve --hmr",
    "start-tls": "npm run webapp:dev-ssl",
    "pretest": "npm run lint",
    "test": "ng test --coverage --log-heap-usage -w=2",
    "test:watch": "npm run test -- --watch",
    "webapp:build": "npm run clean-www && npm run webapp:build:dev",
    "webapp:build:dev": "ng build --configuration development",
    "webapp:build:prod": "ng build --configuration production",
    "webapp:dev": "ng serve",
    "webapp:dev-ssl": "ng serve --ssl",
    "webapp:dev-verbose": "ng serve --verbose",
    "webapp:prod": "npm run clean-www && npm run webapp:build:prod && npm run check:csp",
    "webapp:test": "npm run test --"
  },
  "dependencies": {
    "@angular/animations": "21.2.19",
    "@angular/cdk": "^21.2.14",
    "@angular/common": "21.2.19",
    "@angular/compiler": "21.2.19",
    "@angular/core": "21.2.19",
    "@angular/forms": "21.2.19",
    "@angular/localize": "21.2.19",
    "@angular/material": "^21.2.14",
    "@angular/platform-browser": "21.2.19",
    "@angular/platform-browser-dynamic": "21.2.19",
    "@angular/router": "21.2.19",
    "@fontsource/inter": "^5.3.0",
    "@ngx-translate/core": "^16.0.4",
    "@ngx-translate/http-loader": "^16.0.1",
    "@swimlane/ngx-charts": "^25.0.0",
    "autoprefixer": "^10.4.20",
    "dayjs": "1.11.10",
    "hammerjs": "^2.0.8",
    "material-icons": "^1.13.14",
    "ngx-infinite-scroll": "^21.0.0",
    "ngx-webstorage": "^21.0.1",
    "postcss": "^8.4.49",
    "rxjs": "7.8.1",
    "tailwindcss": "^3.4.17",
    "tslib": "2.6.2",
    "zone.js": "0.15.1"
  },
  "devDependencies": {
    "@angular-builders/custom-webpack": "^21.1.0",
    "@angular-builders/jest": "^21.0.4",
    "@angular-eslint/builder": "21.4.0",
    "@angular-eslint/eslint-plugin": "21.4.0",
    "@angular-eslint/eslint-plugin-template": "21.4.0",
    "@angular-eslint/schematics": "21.4.0",
    "@angular-eslint/template-parser": "21.4.0",
    "@angular/build": "^21.2.20",
    "@angular/cli": "21.2.20",
    "@angular/compiler-cli": "21.2.19",
    "@angular/service-worker": "21.2.19",
    "@types/d3": "^7.4.3",
    "@types/hammerjs": "^2.0.45",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.1",
    "@types/sockjs-client": "^1.5.4",
    "@typescript-eslint/eslint-plugin": "7.11.0",
    "@typescript-eslint/parser": "7.11.0",
    "browser-sync": "3.0.4",
    "browser-sync-webpack-plugin": "2.3.0",
    "buffer": "6.0.3",
    "concurrently": "8.2.2",
    "copy-webpack-plugin": "11.0.0",
    "eslint": "8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-webpack-plugin": "4.0.1",
    "folder-hash": "4.0.4",
    "generator-jhipster": "8.1.0",
    "husky": "8.0.3",
    "jest": "^30.2.0",
    "jest-date-mock": "1.0.8",
    "jest-environment-jsdom": "^30.2.0",
    "jest-junit": "16.0.0",
    "jest-preset-angular": "^17.0.0",
    "jest-sonar": "0.2.16",
    "json-server": "^0.17.4",
    "lint-staged": "15.2.0",
    "merge-jsons-webpack-plugin": "2.0.1",
    "prettier": "3.1.0",
    "prettier-plugin-java": "2.5.0",
    "prettier-plugin-packagejson": "2.4.7",
    "rimraf": "5.0.5",
    "swagger-ui-dist": "5.10.3",
    "ts-jest": "^29.4.9",
    "typescript": "5.9.3",
    "wait-on": "7.2.0",
    "webpack-bundle-analyzer": "4.10.1",
    "webpack-merge": "5.10.0",
    "webpack-notifier": "1.15.0",
    "yaml": "^2.9.0"
  },
  "engines": {
    "node": ">=18.18.2"
  },
  "cacheDirectories": [
    "node_modules"
  ],
  "overrides": {
    "webpack": "5.89.0"
  }
}
